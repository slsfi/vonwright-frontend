{
  "name": "sls-digital-edition-frontend",
  "version": "4.0.0",
  "description": "Angular frontend app for the SLS Digital Edition Platform",
  "homepage": "https://github.com/slsfi/digital-edition-frontend-ng#readme",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.16.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "ng": "ng",
    "prestart": "npm run generate-routes",
    "start": "ng serve --configuration=development,sv",
    "prestart:fi": "npm run generate-routes",
    "start:fi": "ng serve --configuration=development,fi",
    "extract-i18n": "ng extract-i18n",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "generate-routes": "node ./prebuild-generate-routes.js",
    "generate-sitemap": "node ./prebuild-generate-sitemap.js",
    "generate-static-collection-menus": "node ./prebuild-generate-static-collection-menus.js",
    "build:ssr": "npm run generate-routes && ng build --configuration production",
    "serve:ssr": "node dist/app/server/server.mjs",
    "ssr-start": "npm run build:ssr && npm run serve:ssr",
    "test:source-encoding": "node ./scripts/test-source-encoding.js",
    "test:docker-workflow": "node --test ./scripts/test-docker-build-workflow.js",
    "fix:source-bom": "node ./scripts/test-source-encoding.js --fix-bom",
    "test:routes-parser": "node ./scripts/test-prebuild-generate-routes.js",
    "test:build-output": "node ./scripts/test-build-output.js",
    "test:static-collection-menus": "node ./scripts/test-prebuild-generate-static-collection-menus.js",
    "test:ssr:smoke": "node ./scripts/test-ssr-smoke.js",
    "test:ssr:checks": "node ./scripts/test-ssr-smoke-runner.js",
    "test:ssr:server": "npm run build:ssr && node ./scripts/test-ssr-server.js",
    "test:ssr:benchmark": "node ./scripts/test-benchmark-ssr.js",
    "test:ssr:docker": "node ./scripts/docker-ssr-memory.js",
    "test:ssr:docker:checks": "node ./scripts/test-docker-ssr-memory.js",
    "bench:ssr": "node ./scripts/benchmark-ssr.js",
    "bench:ssr:build": "npm run build:ssr && npm run bench:ssr",
    "gzipper": "gzipper",
    "compress": "gzipper compress ./dist/app/browser --include html,htm,xml,txt,css,js,svg,ico,json,ttf,otf --threshold 1300 --gzip-level 9 --remove-larger"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@ionic/angular": "^9.0.8",
    "@ionic/angular-server": "^9.0.8",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "htmlparser2": "^12.0.0",
    "ionicons": "^8.1.0",
    "marked": "^18.1.1",
    "marked-custom-heading-id": "^2.0.17",
    "marked-footnote": "^1.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "gzipper": "^8.3.0",
    "jsdom": "^30.1.3",
    "ng-extract-i18n-merge": "^3.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
